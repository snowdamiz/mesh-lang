fn vectors() -> List<ErasureVector>!String do
  Ok([
    vector_0()?,
    vector_1()?,
    vector_2()?,
    vector_3()?,
    vector_4()?,
    vector_5()?,
    vector_6()?,
    vector_7()?
  ])
end

fn literals() -> Unit!String do
  for value in vectors()? do
    for index in 0..List.length(value.indices) do
      assert(encode_erasure_chunk(value.message,
        value.width,
        List.get(value.indices, index)) == Ok(List.get(value.chunks, index)))
    end
  end
  println("GF16_LITERAL_ENCODING_PASSED")
  Ok(nil)
end

fn repair_literals() -> Unit!String do
  # A nontrivial k3 repair-only literal is first, so a stub cannot pass by
  # returning its input or by treating every valid message as one source word.
  let first = vector_1()?
  assert(decode_erasure_chunks(first.size,
    first.width,
    first.repair_indices,
    first.repair_chunks) == Ok(Some(first.message)))
  for value in vectors()? do
    assert(decode_erasure_chunks(value.size,
      value.width,
      value.repair_indices,
      value.repair_chunks) == Ok(Some(value.message)))
  end
  println("GF16_REPAIR_LITERAL_PASSED")
  Ok(nil)
end

fn systematic_widths() -> Unit!String do
  let message = repeated(87, 1152)?
  for width in 32..257 do
    if width % 2 == 0 do
      let k = (Bytes.length(message) + width - 1) / width
      let padded = Bytes.concat(message, repeated(0, k * width - Bytes.length(message))?)?
      let indices = for index in 0..k do
        index
      end
      let chunks = for index in indices do
        Bytes.slice(padded, index * width, width)?
      end
      for index in 0..k do
        assert(encode_erasure_chunk(message, width, index) == Ok(List.get(chunks, index)))
      end
      assert(decode_erasure_chunks(1152, width, indices, chunks) == Ok(Some(message)))
    end
  end
  println("GF16_ALL113_WIDTHS_SYSTEMATIC_PASSED")
  Ok(nil)
end

fn small_subsets() -> Unit!String do
  let value = vector_1()?
  for a in 0..List.length(value.indices) do
    for b in (a + 1)..List.length(value.indices) do
      for c in (b + 1)..List.length(value.indices) do
        assert(decode_erasure_chunks(value.size,
          value.width,
          [List.get(value.indices, c), List.get(value.indices, b), List.get(value.indices, a)],
          [
            List.get(value.chunks, c),
            List.get(value.chunks, b),
            List.get(value.chunks, a)
          ]) == Ok(Some(value.message)))
      end
    end
  end
  Ok(nil)
end

fn parameter_errors() -> Unit!String do
  let message = repeated(1, 32)?
  for width in [0, 31, 33, 257, 258] do
    assert(encode_erasure_chunk(message, width, 0) == Err(InvalidParameters))
    assert(decode_erasure_chunks(32, width, [], []) == Err(InvalidParameters))
  end
  assert(encode_erasure_chunk(Bytes.empty(), 32, 0) == Err(InvalidParameters))
  assert(encode_erasure_chunk(repeated(1, 1153)?, 32, 0) == Err(InvalidParameters))
  for size in [0, 1153] do
    assert(decode_erasure_chunks(size, 32, [], []) == Err(InvalidParameters))
  end
  for index in [-1, 65536] do
    assert(encode_erasure_chunk(message, 32, index) == Err(InvalidParameters))
    assert(decode_erasure_chunks(32, 32, [index], [message]) == Err(MalformedChunk))
  end
  Ok(nil)
end

fn malformed() -> Unit!String do
  let value = vector_0()?
  let chunk = List.head(value.chunks)
  assert(decode_erasure_chunks(1, 32, [0], []) == Err(MalformedChunk))
  assert(decode_erasure_chunks(1, 32, [], [chunk]) == Err(MalformedChunk))
  for length in [0, 31, 33, 257] do
    assert(decode_erasure_chunks(1, 32, [0], [repeated(0, length)?]) == Err(MalformedChunk))
  end
  let indices = for _index in 0..72 do
    65535
  end
  let payloads = for _index in 0..72 do
    chunk
  end
  assert(decode_erasure_chunks(1, 32, indices, payloads) == Ok(Some(value.message)))
  assert(decode_erasure_chunks(1,
    32,
    indices ++ [65535],
    payloads ++ [chunk]) == Err(MalformedChunk))
  Ok(nil)
end

fn insufficient_rank() -> Unit!String do
  assert(decode_erasure_chunks(1, 32, [], []) == Ok(None))
  let value = vector_1()?
  let chunk = List.head(value.repair_chunks)
  assert(decode_erasure_chunks(value.size, value.width, [65535], [chunk]) == Ok(None))
  assert(decode_erasure_chunks(value.size, value.width, [65535, 65535], [chunk, chunk]) == Ok(None))
  Ok(nil)
end

fn duplicate_and_surplus() -> Unit!String do
  let value = vector_1()?
  let index = List.head(value.repair_indices)
  let chunk = List.head(value.repair_chunks)
  assert(decode_erasure_chunks(value.size,
    value.width,
    value.repair_indices ++ [index],
    value.repair_chunks ++ [chunk]) == Ok(Some(value.message)))
  assert(decode_erasure_chunks(value.size,
    value.width,
    [index, index],
    [chunk, flip(chunk, 0)?]) == Err(ConflictingDuplicate))
  assert(decode_erasure_chunks(value.size,
    value.width,
    value.repair_indices ++ [0],
    value.repair_chunks ++ [flip(List.head(value.chunks), 0)?]) == Err(InconsistentCodewords))
  # The first 36 words and expected message are independent pinned literals.
  # Additional distinct words fill the accepted budget; corrupt only the last.
  let maximum = vector_2()?
  let extra_indices = for index in 0..36 do
    60000 + index
  end
  let extra_chunks = for index in extra_indices do
    case encode_erasure_chunk(maximum.message, maximum.width, index) do
      Err(_) -> return Err("maximum_surplus_fixture_failed")
      Ok(word) -> word
    end
  end
  let all_indices = maximum.repair_indices ++ extra_indices
  let all_chunks = maximum.repair_chunks ++ extra_chunks
  assert(List.length(all_indices) == 72 && List.length(all_chunks) == 72)
  assert(decode_erasure_chunks(maximum.size,
    maximum.width,
    all_indices,
    all_chunks) == Ok(Some(maximum.message)))
  let wrong_last = List.take(all_chunks, 71) ++ [flip(List.last(all_chunks), 0)?]
  assert(decode_erasure_chunks(maximum.size,
    maximum.width,
    all_indices,
    wrong_last) == Err(InconsistentCodewords))
  Ok(nil)
end

fn padding() -> Unit!String do
  for value in [vector_1()?, vector_5()?] do
    let k = (value.size + value.width - 1) / value.width
    let indices = for index in 0..k do
      index
    end
    let chunks = List.take(value.chunks, k)
    let wrong = List.take(chunks, k - 1) ++ [flip(List.get(chunks, k - 1), value.width - 1)?]
    assert(decode_erasure_chunks(value.size,
      value.width,
      indices,
      chunks) == Ok(Some(value.message)))
    assert(decode_erasure_chunks(value.size,
      value.width,
      indices,
      wrong) == Err(InconsistentCodewords))
  end
  Ok(nil)
end

test("literal systematic and repair words match independent polynomial and Newton reference") do
  case literals() do
    Err(error) -> do
      println(error)
      assert(false)
    end
    Ok(_) -> nil
  end
end

test("literal repair-only words reconstruct odd, maximum and equal-payload source messages") do
  case repair_literals() do
    Err(error) -> do
      println(error)
      assert(false)
    end
    Ok(_) -> nil
  end
end

test("all113 valid widths preserve systematic bytes and maximum-size reconstruction") do
  case systematic_widths() do
    Err(error) -> do
      println(error)
      assert(false)
    end
    Ok(_) -> nil
  end
end

test("all k3 subsets and reversed ordering reconstruct pinned bytes") do
  case small_subsets() do
    Err(error) -> do
      println(error)
      assert(false)
    end
    Ok(_) -> nil
  end
end

test("parameters and finite evaluation-domain boundaries fail closed") do
  case parameter_errors() do
    Err(error) -> do
      println(error)
      assert(false)
    end
    Ok(_) -> nil
  end
end

test("empty short malformed and72/73 pre-dedup entries obey bounds") do
  case malformed() do
    Err(error) -> do
      println(error)
      assert(false)
    end
    Ok(_) -> nil
  end
end

test("duplicates and inconsistent surplus words retain finite refusal") do
  case duplicate_and_surplus() do
    Err(error) -> do
      println(error)
      assert(false)
    end
    Ok(_) -> nil
  end
end

test("both ordinary and1380byte padded workspace reject nonzero padding") do
  case padding() do
    Err(error) -> do
      println(error)
      assert(false)
    end
    Ok(_) -> nil
  end
end

test("empty input and identical duplicates below independent rank remain incomplete") do
  case insufficient_rank() do
    Err(error) -> do
      println(error)
      assert(false)
    end
    Ok(_) -> nil
  end
end
