{
  "name": "mesh-light",
  "type": "light",
  "colors": {
    "editor.background": "#f7f2ea",
    "editor.foreground": "#3d3934"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#3d3934",
        "background": "#f7f2ea"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#6b645b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc Comments",
      "scope": [
        "comment.line.documentation",
        "comment.line.documentation.module"
      ],
      "settings": {
        "foreground": "#6b645b",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#3a722e"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#9f531a"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.declaration",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#b93c0d"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "storage.modifier.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#b93c0d"
      }
    },
    {
      "name": "Keyword Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#6b645b"
      }
    },
    {
      "name": "Word Operators",
      "scope": [
        "keyword.operator.mesh"
      ],
      "settings": {
        "foreground": "#b93c0d"
      }
    },
    {
      "name": "Types and Modules",
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#8a5a12"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#181818"
      }
    },
    {
      "name": "Constructors",
      "scope": [
        "support.function.mesh"
      ],
      "settings": {
        "foreground": "#8a5a12"
      }
    },
    {
      "name": "Numbers and Literals",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#9f531a"
      }
    },
    {
      "name": "Atoms",
      "scope": [
        "constant.language.atom"
      ],
      "settings": {
        "foreground": "#2f6a9a"
      }
    },
    {
      "name": "Supervisor Values",
      "scope": [
        "constant.language.supervisor"
      ],
      "settings": {
        "foreground": "#3d3934"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.language.wildcard",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#3d3934"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#6b645b"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#b93c0d"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b3321c",
        "fontStyle": "underline"
      }
    }
  ]
}
