{
  "name": "mesh-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#141312",
    "editor.foreground": "#ddd6ca"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#ddd6ca",
        "background": "#141312"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#918b7f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc Comments",
      "scope": [
        "comment.line.documentation",
        "comment.line.documentation.module"
      ],
      "settings": {
        "foreground": "#918b7f",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b5d49a"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f0b07a"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.declaration",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#ff8f61"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "storage.modifier.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#ff8f61"
      }
    },
    {
      "name": "Keyword Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#b3aa9c"
      }
    },
    {
      "name": "Word Operators",
      "scope": [
        "keyword.operator.mesh"
      ],
      "settings": {
        "foreground": "#ff8f61"
      }
    },
    {
      "name": "Types and Modules",
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#f1cd92"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#f4efe6"
      }
    },
    {
      "name": "Constructors",
      "scope": [
        "support.function.mesh"
      ],
      "settings": {
        "foreground": "#f1cd92"
      }
    },
    {
      "name": "Numbers and Literals",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#f0b07a"
      }
    },
    {
      "name": "Atoms",
      "scope": [
        "constant.language.atom"
      ],
      "settings": {
        "foreground": "#a9cbe9"
      }
    },
    {
      "name": "Supervisor Values",
      "scope": [
        "constant.language.supervisor"
      ],
      "settings": {
        "foreground": "#ddd6ca"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.language.wildcard",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#ddd6ca"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#918b7f"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#ff8f61"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b57",
        "fontStyle": "underline"
      }
    }
  ]
}
