+// Untimed single-run probe. Buffer observations until dispatcher exit.
+thread_local! {
+    static REFILL_PROBE: std::cell::RefCell<Vec<(&'static str, Instant, usize, usize, usize)>> =
+        const { std::cell::RefCell::new(Vec::new()) };
+}
+
+fn probe_at(kind: &'static str, at: Instant, active: usize, reserved: usize, detail: usize) {
+    REFILL_PROBE.with_borrow_mut(|rows| rows.push((kind, at, active, reserved, detail)));
+}
+
+fn probe(kind: &'static str, active: usize, reserved: usize, detail: usize) {
+    probe_at(kind, Instant::now(), active, reserved, detail);
+}
+
+struct FlushRefillProbe(Instant, u128);
+impl Drop for FlushRefillProbe {
+    fn drop(&mut self) {
+        eprintln!("refill_probe_origin {}", self.1);
+        REFILL_PROBE.with_borrow_mut(|rows| {
+            rows.sort_by_key(|row| row.1);
+            for (kind, instant, active, reserved, detail) in rows.drain(..) {
+                eprintln!("refill_probe {} {kind} {active} {reserved} {detail}",
+                    instant.duration_since(self.0).as_micros());
+            }
+        });
+    }
+}

