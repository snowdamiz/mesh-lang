+#[cfg(test)]
+#[test]
+fn refill_wait_is_bounded_and_only_aggregates_under_live_demand() {
+    let now = Instant::now();
+    let mut refill = RefillWait::default();
+    assert_eq!(refill.until(now, 1, || true), None);
+    refill.observe_reply(true);
+    assert_eq!(refill.until(now, 1, || false), None);
+    let deadline = now + Duration::from_micros(500);
+    assert_eq!(refill.until(now, 1, || true), Some(deadline));
+    assert_eq!(refill.until(now + Duration::from_micros(300), 2, || true), Some(deadline));
+    assert_eq!(refill.until(now + Duration::from_micros(300), 3, || true), None);
+    assert_eq!(refill.until(deadline, 1, || true), None);
+    refill.observe_reply(false);
+    assert_eq!(refill.until(deadline, 2, || true), None);
+    refill.observe_reply(true);
+    assert_eq!(refill.until(deadline, 2, || true), Some(deadline + Duration::from_micros(500)));
+}
