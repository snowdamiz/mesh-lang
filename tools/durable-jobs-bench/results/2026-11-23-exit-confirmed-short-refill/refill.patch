+#[derive(Default)]
+struct RefillWait {
+    full_grant: bool,
+    deadline: std::cell::Cell<Option<Instant>>,
+}
+
+impl RefillWait {
+    fn observe_reply(&mut self, full_grant: bool) {
+        self.full_grant = full_grant;
+        self.deadline.set(None);
+    }
+
+    fn until(&self, now: Instant, free: usize, other_work: impl FnOnce() -> bool) -> Option<Instant> {
+        const WIDTH: usize = 3;
+        const WAIT: Duration = Duration::from_micros(500);
+        if !self.full_grant || free >= WIDTH || !other_work() {
+            return None;
+        }
+        // Keep the first deadline through later releases and spurious wakeups.
+        let until = self.deadline.get().unwrap_or(now + WAIT);
+        self.deadline.set(Some(until));
+        (now < until).then_some(until)
+    }
 }
 
