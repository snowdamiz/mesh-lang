#!/usr/bin/env bash
set -euo pipefail
base=/var/lib/durable-jobs-bench/native
here="$(cd "$(dirname "$0")" && pwd -P)"
[[ "$here" == "$base/dense-hot-readiness-1e70f18d-logger-off" ]]
[[ $# == 3 && "$1" == mesh && "$2" == noop && "$3" == /* && ! -L "$3" ]]
case "${CHECKOUT_MODE:?}" in
    hot-sync|hot-ready|cold-ready) ;;
    *) exit 2 ;;
esac
[[ "${PRODUCT_ELF_SHA256:?}" =~ ^[a-f0-9]{64}$ && "${PRODUCT_MANIFEST_SHA256:?}" =~ ^[a-f0-9]{64}$ ]]
phase="${DURABLE_JOBS_PHASE:?}"
if [[ "$phase" == diagnostic ]]; then
    # Setup owns both host locks and only qualifies its own fresh output.
    [[ "$3" == "$base/runs/dense-hot-readiness-1e70f18d-logger-off/"* ]]
else
    [[ "$phase" == measured || "$phase" == warmup ]]
    exec 9<"$base/native.lock"
    flock -n 9
fi
[[ "$(id -u)" == 0 && -d "$3" && -z "$(find "$3" -mindepth 1 -maxdepth 1 -print -quit)" ]]
chown nobody:nogroup "$3"
chmod 0700 "$3"
exec runuser -u nobody -- env -i PATH=/usr/sbin:/usr/bin:/bin LC_ALL=C.UTF-8     "PG_BIN_DIR=$base/toolchain/pgsql-17.11/bin" "NATIVE_JOBS_STATE=$here"     "PRODUCT_SOURCE=$here/source" "PRODUCT_FROZEN_HARNESS=$base/source-bulk-enqueue-3b09dc3d0e23/ordinary-v2"     "NATIVE_JOBS_ARTIFACTS=$here/artifacts/jobs" "DURABLE_JOBS_PHASE=$phase"     "CHECKOUT_MODE=$CHECKOUT_MODE" "PRODUCT_ELF_SHA256=$PRODUCT_ELF_SHA256"     "PRODUCT_MANIFEST_SHA256=$PRODUCT_MANIFEST_SHA256"     python3 -B "$here/adapter.py" "$@"
