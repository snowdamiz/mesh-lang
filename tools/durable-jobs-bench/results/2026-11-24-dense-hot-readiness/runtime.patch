+/// Park at the TCP boundary so the same stack retains partial protocol
+/// frames, rustls record buffers, and row decoding state.
+struct PgSocket {
+    tcp: TcpStream,
+    deadline: Option<Instant>,
+}
+
+impl PgSocket {
+    fn new(tcp: TcpStream) -> Self {
+        Self {
+            tcp,
+            deadline: None,
+        }
+    }
+
+    fn transfer<T>(
+        &mut self,
+        interest: mio::Interest,
+        mut transfer: impl FnMut(&mut TcpStream) -> std::io::Result<T>,
+    ) -> std::io::Result<T> {
+        #[cfg(unix)]
+        if let Some(deadline) = self.deadline {
+            use std::io::ErrorKind;
+            use std::os::fd::AsRawFd;
+
+            loop {
+                if Instant::now() >= deadline {
+                    return Err(ErrorKind::TimedOut.into());
+                }
+                match transfer(&mut self.tcp) {
+                    Err(error) if error.kind() == ErrorKind::WouldBlock => {
+                        super::readiness::wait(self.tcp.as_raw_fd(), interest, deadline)?;
+                    }
+                    Err(error) if error.kind() == ErrorKind::Interrupted => continue,
+                    result => return result,
+                }
+            }
+        }
+        #[cfg(not(unix))]
+        let _ = interest;
+        transfer(&mut self.tcp)
+    }
+}
+
