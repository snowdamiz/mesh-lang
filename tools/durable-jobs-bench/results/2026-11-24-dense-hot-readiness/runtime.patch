+/// Suspend a native database frame. The PG decoder can hold actor references
+/// in its Rust row vector, so collection waits for the next Mesh safe point.
+pub(crate) fn recv_during_pg_io<T>(
+    receiver: &std::sync::mpsc::Receiver<T>,
+    deadline: Option<std::time::Instant>,
+) -> Result<T, std::sync::mpsc::RecvTimeoutError> {
+    use std::sync::mpsc::{RecvTimeoutError, TryRecvError};
+    let (pid, me) = running_process();
+    if let Some(deadline) = deadline {
+        wake_at(pid, deadline);
+    }
+    loop {
+        let alive = me.lock().set_live_state(ProcessState::Waiting);
+        if alive {
+            let result = match receiver.try_recv() {
+                Ok(value) => Some(Ok(value)),
+                Err(TryRecvError::Disconnected) => Some(Err(RecvTimeoutError::Disconnected)),
+                Err(TryRecvError::Empty) => deadline
+                    .is_some_and(|until| std::time::Instant::now() >= until)
+                    .then_some(Err(RecvTimeoutError::Timeout)),
+            };
+            if let Some(result) = result {
+                if me.lock().set_live_state(ProcessState::Ready) {
+                    return result;
+                }
+            }
+        }
+        stack::suspend_current();
     }
 }
 
