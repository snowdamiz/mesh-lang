+
+impl ActorLease<'_> {
+    fn conn(&mut self) -> &mut PgConn {
+        unsafe { &mut *(self.handle as *mut PgConn) }
+    }
+
+    fn finish(mut self) {
+        let conn = self.conn();
+        if conn.is_broken() {
+            return;
+        }
+        if conn.txn_status != b'I' {
+            conn.renew_cooperative_deadline();
+            if pg_simple_command(conn, "ROLLBACK").is_err() || conn.txn_status != b'I' {
+                return;
+            }
+        }
+        if conn.end_cooperative().is_err() {
+            return;
+        }
+        let mut inner = self.pool.inner.lock();
+        if !inner.closed {
+            inner.leased.remove(&self.handle);
+            inner.idle.push(IdleConnection::new(self.handle));
+            self.handle = 0;
+            drop(inner);
+            self.pool.notify_slot();
+        }
+    }
