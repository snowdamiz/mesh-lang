+
+impl Drop for ActorLease<'_> {
+    fn drop(&mut self) {
+        if self.handle != 0 {
+            // Keep the connection counted until its file descriptor has closed.
+            // Remove provenance first, before the allocator can reuse the pointer.
+            self.pool.inner.lock().leased.remove(&self.handle);
+            unsafe { pg::abort(self.handle) };
+            self.pool.inner.lock().total_created -= 1;
+            self.pool.notify_slot();
+        }
+    }
