+//! Readiness notifications for PostgreSQL sockets owned by an actor.
+//! Only the owner registers or deregisters its live file descriptor.
+
+use std::collections::HashMap;
+use std::io::{self, ErrorKind};
+use std::os::fd::RawFd;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, OnceLock};
+use std::time::Instant;
+
+use mio::unix::SourceFd;
+use mio::{Events, Interest, Poll, Registry, Token, Waker};
+use parking_lot::Mutex;
+
+use crate::actor::{cooperative_channel, recv_during_pg_io, CooperativeSender};
+
+const CONTROL: Token = Token(0);
+
+type Reply = CooperativeSender<io::Result<()>>;
+
+struct Waiting {
+    deadline: Instant,
+    reply: Reply,
+}
+
+#[derive(Default)]
+struct Pending {
+    waits: HashMap<Token, Waiting>,
+    polling_until: Option<Instant>,
+    stopped: bool,
+}
+
+struct Reactor {
+    registry: Registry,
+    control: Waker,
+    pending: Arc<Mutex<Pending>>,
+    next_token: AtomicUsize,
+}
+
+impl Reactor {
+    fn start() -> io::Result<Self> {
+        let poll = Poll::new()?;
+        let registry = poll.registry().try_clone()?;
+        let control = Waker::new(poll.registry(), CONTROL)?;
+        let pending = Arc::new(Mutex::new(Pending::default()));
+        let shared = pending.clone();
+        std::thread::Builder::new()
+            .name("mesh-pg-readiness".into())
+            .spawn(move || run(poll, &shared))?;
+        Ok(Self {
+            registry,
+            control,
+            pending,
+            next_token: AtomicUsize::new(1),
+        })
+    }
+
+    fn register(
+        &'static self,
+        fd: RawFd,
+        interest: Interest,
+        deadline: Instant,
+        reply: Reply,
+    ) -> io::Result<Registration> {
+        let token = Token(
+            self.next_token
+                .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |token| {
+                    token.checked_add(1)
+                })
+                .map_err(|_| io::Error::other("PostgreSQL readiness tokens exhausted"))?,
+        );
+        let wake = {
+            let mut pending = self.pending.lock();
+            if pending.stopped {
+                return Err(io::Error::other("PostgreSQL readiness reactor stopped"));
+            }
+            pending.waits.insert(token, Waiting { deadline, reply });
+            pending
+                .polling_until
+                .is_none_or(|current| deadline < current)
+        };
+        if let Err(error) = self.registry.register(&mut SourceFd(&fd), token, interest) {
+            self.pending.lock().waits.remove(&token);
+            return Err(error);
+        }
+        let registration = Registration {
+            reactor: self,
+            fd,
+            token,
+        };
+        if wake {
+            self.control.wake()?;
+        }
+        Ok(registration)
+    }
+}
+
+struct Registration {
+    reactor: &'static Reactor,
+    fd: RawFd,
+    token: Token,
+}
+
+impl Drop for Registration {
+    fn drop(&mut self) {
+        let _ = self.reactor.registry.deregister(&mut SourceFd(&self.fd));
+        self.reactor.pending.lock().waits.remove(&self.token);
+    }
+}
+
+fn run(mut poll: Poll, pending: &Mutex<Pending>) {
+    let mut events = Events::with_capacity(128);
+    loop {
+        let now = Instant::now();
+        let mut expired = Vec::new();
+        let next = {
+            let mut pending = pending.lock();
+            let mut next = None::<Instant>;
+            pending.waits.retain(|_, waiting| {
+                if waiting.deadline <= now {
+                    expired.push(waiting.reply.clone());
+                    return false;
+                }
+                next = Some(next.map_or(waiting.deadline, |prior| prior.min(waiting.deadline)));
+                true
+            });
+            pending.polling_until = next;
+            next
+        };
+        for reply in expired {
+            let _ = reply.send(Err(ErrorKind::TimedOut.into()));
+        }
+        match poll.poll(
+            &mut events,
+            next.map(|deadline| deadline.saturating_duration_since(Instant::now())),
+        ) {
+            Ok(()) => {}
+            Err(error) if error.kind() == ErrorKind::Interrupted => continue,
+            Err(_) => break,
+        }
+        for event in &events {
+            let waiting = pending.lock().waits.remove(&event.token());
+            if let Some(waiting) = waiting {
+                let _ = waiting.reply.send(Ok(()));
+            }
+        }
+    }
+    let waiting = {
+        let mut pending = pending.lock();
+        pending.stopped = true;
+        std::mem::take(&mut pending.waits)
+    };
+    for (_, waiting) in waiting {
+        let _ = waiting.reply.send(Err(io::Error::other(
+            "PostgreSQL readiness reactor stopped",
+        )));
+    }
+}
+
+pub(super) fn wait(fd: RawFd, interest: Interest, deadline: Instant) -> io::Result<()> {
+    static REACTOR: OnceLock<Result<Reactor, String>> = OnceLock::new();
+    let reactor = REACTOR
+        .get_or_init(|| Reactor::start().map_err(|error| error.to_string()))
+        .as_ref()
+        .map_err(|error| io::Error::other(error.clone()))?;
+    static TRACE: OnceLock<bool> = OnceLock::new();
+    if *TRACE.get_or_init(|| std::env::var_os("MESH_PG_TRACE_WAITS").is_some()) {
+        let direction = if interest.is_readable() {
+            "read"
+        } else {
+            "write"
+        };
+        eprintln!("postgres socket wait {direction}");
+    }
+    let (reply, receiver) = cooperative_channel();
+    let _registration = reactor.register(fd, interest, deadline, reply)?;
+    recv_during_pg_io(&receiver, None).map_err(io::Error::other)?
+}
