+#[test]
+fn jobs_app_pool_requires_a_concrete_named_handler_and_two_pool_handles() {
+    let setup = r#"
+from Jobs import start_with_app_pool
+
+fn scoped(job :: String, app :: PoolHandle) -> String do job end
+fn unscoped(job :: String) -> String do job end
+fn generic(job, _app) do job end
+"#;
+    for (expr, accepted) in [
+        (
+            r#"Jobs.start_with_app_pool(queue, "{}", scoped, app)"#,
+            true,
+        ),
+        (r#"scoped |3> start_with_app_pool(queue, "{}", app)"#, true),
+        (
+            r#"Jobs.start_with_app_pool(queue, "{}", unscoped, app)"#,
+            false,
+        ),
+        (
+            r#"Jobs.start_with_app_pool(queue, "{}", generic, app)"#,
+            false,
+        ),
+        (
+            r#"Jobs.start_with_app_pool(queue, "{}", alias, app)"#,
+            false,
+        ),
+        (
+            r#"Jobs.start_with_app_pool(queue, "{}", fn(job, a) do job end, app)"#,
+            false,
+        ),
+        (
+            r#"Jobs.start_with_app_pool(queue, "{}", scoped, 42)"#,
+            false,
+        ),
+        (r#"Jobs.start(queue, "{}", scoped)"#, false),
+        ("Jobs.start_with_app_pool", false),
+        ("start_with_app_pool", false),
+        ("jobs_start_with_app_pool", false),
+    ] {
+        let result = check(&format!("{setup}\nfn run(queue :: PoolHandle, app :: PoolHandle) do\n  let alias = scoped\n  {expr}\nend"));
+        assert_eq!(
+            result.errors.is_empty(),
+            accepted,
+            "{expr}: {:?}",
+            result.errors
+        );
+    }
+}
