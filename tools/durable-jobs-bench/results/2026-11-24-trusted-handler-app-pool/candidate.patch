+
+pub(super) type ApplicationHandler =
+    unsafe extern "C-unwind" fn(*const crate::MeshString, u64) -> *const crate::MeshString;
+
+pub(super) fn start_with_app_pool(
+    pool: u64,
+    config_json: &str,
+    handler: Option<ApplicationHandler>,
+    env_ptr: *const u8,
+    app_pool: u64,
+) -> Result<u64, String> {
+    let config = Config::parse(config_json)?;
+    if config.execution != WorkerExecution::TrustedSharedProcess {
+        return Err("Jobs.start_with_app_pool requires trusted_shared_process execution".into());
+    }
+    let handler = handler
+        .filter(|_| env_ptr.is_null())
+        .ok_or("runner handler must be a named fn(String, PoolHandle) -> String")?;
+    if pool == 0 || pool == app_pool || !unsafe { crate::db::pool::is_open(app_pool) } {
+        return Err("runner requires a distinct, open application pool".into());
+    }
+    // Pools retain their identity after close. The application still owns the pool,
+    // and each attempt receives only the handle captured by this runner.
+    let launch: Box<StartWorker> =
+        Box::new(move |context, deadline, lease_deadline, reply_wake| {
+            Ok(Box::new(TrustedAttempt::start(
+                move |input| unsafe { handler(input, app_pool) },
+                context,
+                deadline,
+                lease_deadline,
+                reply_wake,
+            )?))
+        });
     start_configured(pool, config, check_executable, launch, None).map(|runner| runner.id)
 }
 
