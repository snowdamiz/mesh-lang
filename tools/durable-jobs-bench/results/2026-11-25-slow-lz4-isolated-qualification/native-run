#!/bin/bash
set -euo pipefail
overlay="$(cd "$(dirname "$0")" && pwd -P)"
base=/var/lib/durable-jobs-bench/native
prefix="${1:?private PostgreSQL prefix}"
state="${2:?private scratch}"
engine="${3:?engine}"
policy="${4:?policy}"
arm="${5:?pinned adapter}"
profile="${6:?profile}"
out="${7:?evidence directory}"
artifact="${NATIVE_JOBS_ARTIFACTS:?pinned release artifact}"
[[ $# == 7 && $(id -u) == 0 && "$arm" == "$base"/source-*/* && "$profile" == slow ]]
[[ "$prefix" == "$base"/slow-lz4-isolated-*/work/pgsql-17.11-lz4-537512904744 ]]
[[ "$state" == "${prefix%/*}" && "$artifact" == "$base"/builds/* && -d "$artifact" ]]
[[ -d "$out" && ! -L "$out" && -z "$(find "$out" -mindepth 1 -maxdepth 1 -print -quit)" ]]
case "$engine" in mesh|oban) ;; *) exit 2 ;; esac
exec 9<"$base/native.lock"
flock -n 9
tool="$base/toolchain"
chown nobody:nogroup "$out"
chmod 0700 "$out"
cd "$(dirname "$arm")"
exec runuser -u nobody -- env -i \
    "PATH=$tool/otp-29.1.1/bin:$tool/elixir-1.20.4/bin:/usr/sbin:/usr/bin:/bin" \
    LC_ALL=C.UTF-8 "PG_BIN_DIR=$prefix/bin" ERL_CRASH_DUMP=/dev/null \
    "DURABLE_JOBS_PHASE=${DURABLE_JOBS_PHASE:-diagnostic}" \
    "NATIVE_JOBS_STATE=$state" "NATIVE_JOBS_ARTIFACTS=$artifact" MESH_JOBS_SET_BASED_ENQUEUE=1 \
    /usr/bin/python3 -B "$overlay/overlay.py" "$engine" "$policy" "$arm" "$engine" "$profile" "$out"
