diff --git a/compiler/mesh-rt/src/jobs/pg17_lock_exact.c b/compiler/mesh-rt/src/jobs/pg17_lock_exact.c
new file mode 100644
index 00000000..7354c51e
--- /dev/null
+++ b/compiler/mesh-rt/src/jobs/pg17_lock_exact.c
@@ -0,0 +1,118 @@
+#include "postgres.h"
+
+#include "access/heapam.h"
+#include "access/htup_details.h"
+#include "access/sysattr.h"
+#include "access/table.h"
+#include "access/tableam.h"
+#include "access/xact.h"
+#include "catalog/namespace.h"
+#include "catalog/pg_am_d.h"
+#include "catalog/pg_collation_d.h"
+#include "catalog/pg_type_d.h"
+#include "executor/tuptable.h"
+#include "fmgr.h"
+#include "miscadmin.h"
+#include "nodes/makefuncs.h"
+#include "storage/bufmgr.h"
+#include "utils/acl.h"
+#include "utils/builtins.h"
+#include "utils/lsyscache.h"
+#include "utils/rel.h"
+#include "utils/rls.h"
+#include "utils/snapmgr.h"
+#include "utils/uuid.h"
+
+#if PG_VERSION_NUM / 10000 != 17
+#error "The Jobs exact-tuple diagnostic is built and qualified for PostgreSQL 17"
+#endif
+
+PG_MODULE_MAGIC;
+PG_FUNCTION_INFO_V1(mesh_jobs_lock_exact);
+
+Datum
+mesh_jobs_lock_exact(PG_FUNCTION_ARGS)
+{
+    text *namespace = PG_GETARG_TEXT_PP(0);
+    pg_uuid_t *job_id = PG_GETARG_UUID_P(1);
+    TransactionId version = PG_GETARG_TRANSACTIONID(2);
+    ItemPointer location = (ItemPointer) DatumGetPointer(PG_GETARG_DATUM(3));
+    ItemPointerData target = *location;
+    Oid role = GetUserId();
+    Oid oid;
+    Relation relation;
+    TupleTableSlot *slot;
+    AttrNumber ns_column;
+    AttrNumber id_column;
+    AttrNumber state_column;
+    Snapshot snapshot = GetActiveSnapshot();
+    TM_FailureData failure;
+    const char *status = "stale";
+    bool is_null;
+    Datum row_ns;
+    Datum row_id;
+    Datum row_xmin;
+
+    oid = RangeVarGetRelid(makeRangeVar("mesh_jobs", "jobs", -1), RowShareLock, false);
+    relation = table_open(oid, NoLock);
+    ns_column = get_attnum(oid, "namespace");
+    id_column = get_attnum(oid, "id");
+    state_column = get_attnum(oid, "state");
+    if (relation->rd_rel->relkind != RELKIND_RELATION ||
+        relation->rd_rel->relam != HEAP_TABLE_AM_OID ||
+        ns_column <= 0 || id_column <= 0 || state_column <= 0 ||
+        get_atttype(oid, ns_column) != TEXTOID || get_atttype(oid, id_column) != UUIDOID ||
+        XactIsoLevel != XACT_READ_COMMITTED)
+        ereport(ERROR, (errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+                        errmsg("mesh jobs exact lock requires the PostgreSQL 17 heap Jobs schema and READ COMMITTED")));
+    if (pg_class_aclcheck(oid, role, ACL_SELECT) != ACLCHECK_OK ||
+        (pg_class_aclcheck(oid, role, ACL_UPDATE) != ACLCHECK_OK &&
+         pg_attribute_aclcheck(oid, state_column, role, ACL_UPDATE) != ACLCHECK_OK) ||
+        check_enable_rls(oid, InvalidOid, true) == RLS_ENABLED)
+        ereport(ERROR, (errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+                        errmsg("mesh jobs exact lock requires updating Jobs access without row security")));
+
+    if (!ItemPointerIsValid(location) ||
+        ItemPointerGetOffsetNumber(location) > MaxHeapTuplesPerPage ||
+        ItemPointerGetBlockNumber(location) >= RelationGetNumberOfBlocks(relation))
+    {
+        table_close(relation, NoLock);
+        PG_RETURN_TEXT_P(cstring_to_text("stale"));
+    }
+
+    slot = table_slot_create(relation, NULL);
+    /*
+     * A fixed physical tuple must be visible and match the supplied logical
+     * identity. The preparation cursor pins its prior MVCC snapshot too.
+     */
+    if (table_tuple_fetch_row_version(relation, &target, snapshot, slot))
+    {
+        row_xmin = slot_getsysattr(slot, MinTransactionIdAttributeNumber, &is_null);
+        if (!is_null && DatumGetTransactionId(row_xmin) == version)
+        {
+            row_ns = slot_getattr(slot, ns_column, &is_null);
+            if (!is_null && DatumGetBool(DirectFunctionCall2Coll(texteq, DEFAULT_COLLATION_OID,
+                                           row_ns, PointerGetDatum(namespace))))
+            {
+                row_id = slot_getattr(slot, id_column, &is_null);
+                if (!is_null && memcmp(DatumGetUUIDP(row_id)->data, job_id->data, UUID_LEN) == 0)
+                {
+                    ExecClearTuple(slot);
+                    /* Neither flag is set. Never lock a descendant of target. */
+                    TM_Result locked = table_tuple_lock(relation, &target, snapshot, slot,
+                        GetCurrentCommandId(false), LockTupleNoKeyExclusive, LockWaitSkip,
+                        0, &failure);
+                    Assert(ItemPointerEquals(&target, location));
+                    if (locked == TM_Ok)
+                        status = "locked";
+                    else if (locked == TM_WouldBlock)
+                        status = "busy";
+                }
+            }
+        }
+    }
+
+    ExecDropSingleTupleTableSlot(slot);
+    table_close(relation, NoLock);
+    PG_RETURN_TEXT_P(cstring_to_text(status));
+}
diff --git a/compiler/mesh-rt/src/jobs/prepare_claim_install.sql b/compiler/mesh-rt/src/jobs/prepare_claim_install.sql
new file mode 100644
index 00000000..39660a1d
--- /dev/null
+++ b/compiler/mesh-rt/src/jobs/prepare_claim_install.sql
@@ -0,0 +1,39 @@
+-- Execute with psql as a database administrator after Jobs.migrate.
+-- Set module_path to the verified PostgreSQL 17 module and worker to the exact role.
+\set ON_ERROR_STOP 1
+BEGIN;
+SELECT pg_catalog.pg_advisory_xact_lock(1782495102, 1);
+
+CREATE OR REPLACE FUNCTION mesh_jobs.lock_exact_v1(text, uuid, xid, tid)
+RETURNS text
+AS :'module_path', 'mesh_jobs_lock_exact'
+LANGUAGE c STRICT VOLATILE PARALLEL UNSAFE SET search_path = pg_catalog, pg_temp;
+
+\ir prepare_claim_schema.sql
+
+REVOKE EXECUTE ON FUNCTION mesh_jobs.lock_exact_v1(text,uuid,xid,tid) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION mesh_jobs.lock_exact_v1(text,uuid,xid,tid),
+    mesh_jobs.prepare_batch_v1(text,text,jsonb,integer),
+    mesh_jobs.activate_batch_v1(text,text,jsonb,bigint,xid8,jsonb,boolean) TO :"worker";
+-- A named default ACL can grant execution even after PUBLIC is revoked.
+SELECT pg_catalog.set_config('mesh_jobs.prepare_worker_role', :'worker', true);
+DO $$
+BEGIN
+    IF EXISTS (
+        SELECT
+        FROM pg_catalog.pg_proc p
+        CROSS JOIN LATERAL pg_catalog.aclexplode(p.proacl) a
+        WHERE p.oid = ANY (ARRAY[
+            'mesh_jobs.lock_exact_v1(text,uuid,xid,tid)'::regprocedure,
+            'mesh_jobs.prepare_batch_v1(text,text,jsonb,integer)'::regprocedure,
+            'mesh_jobs.activate_batch_v1(text,text,jsonb,bigint,xid8,jsonb,boolean)'::regprocedure
+        ])
+        AND a.privilege_type = 'EXECUTE' AND a.grantee <> p.proowner
+        AND a.grantee <> pg_catalog.to_regrole(pg_catalog.quote_ident(
+            pg_catalog.current_setting('mesh_jobs.prepare_worker_role')))
+    ) THEN
+        RAISE EXCEPTION 'mesh jobs exact tuple protocol has an unexpected named EXECUTE grant';
+    END IF;
+END
+$$;
+COMMIT;
