+use super::{decode_claim_batch, rollback_error, ClaimBatch, MAX_CLAIM_BATCH};
+use crate::db::jobs_connection::PgJobDb;
+use serde::Serialize;
+use std::collections::{HashMap, HashSet};
+
+pub(in crate::jobs) const PROTOCOL: &str = "locked_prepare_pg17_v1";
+
+pub(in crate::jobs) fn enabled() -> bool {
+    std::env::var("MESH_JOBS_BATCH_PROTOCOL").is_ok_and(|mode| mode == PROTOCOL)
+}
+
+#[derive(Serialize)]
+struct Entry {
+    id: String,
+    token: Option<String>,
+    row_version: String,
+    row_location: String,
+    context_bytes: usize,
+}
+
+const PREPARE: &str = "
+    SELECT status, id, token, context, timeout_ms, context_bytes, ordinality::text,
+           row_version, row_location, CASE WHEN ordinality = 1 THEN transaction_id END
+    FROM mesh_jobs.prepare_batch_v1($1, $2, $3::jsonb, $4::integer) WITH ORDINALITY";
+
+const ACTIVATE: &str = "
+    WITH admitted AS MATERIALIZED (
+        SELECT status, id, observed_at_ms, ordinality
+        FROM mesh_jobs.activate_batch_v1($1, $2, $3::jsonb, $4::bigint, $5::xid8,
+                                         $6::jsonb, $7::boolean) WITH ORDINALITY
+    )
+    SELECT status, id, observed_at_ms
+    FROM (
+        SELECT 'count' AS status, count(*)::text AS id, NULL::text AS observed_at_ms, 0 AS ordinality
+        FROM admitted
+        UNION ALL
+        SELECT status, id, observed_at_ms, ordinality FROM admitted
+    ) AS confirmed
+    ORDER BY ordinality";
+
+const MAX_BATCH_WIRE_BYTES: usize = 32 * 1024 * 1024;
+
+const BEGIN: &str = "
+    BEGIN ISOLATION LEVEL READ COMMITTED;
+    SELECT pg_catalog.set_config(name, least(coalesce(nullif(setting::integer, 0),
+        bound), bound)::text, true)
+    FROM pg_catalog.pg_settings JOIN (VALUES ('transaction_timeout', 10000),
+        ('lock_timeout', 250)) AS limits(name, bound) USING (name)";
+
+pub(in crate::jobs) fn claim<L>(
+    db: &mut PgJobDb<'_>,
+    namespace: &str,
+    queue: &str,
+    workers: &str,
+    lease_ms: u64,
+    slots: usize,
+    observe: bool,
+    begin_lease: impl FnOnce() -> Result<L, String>,
+) -> Result<(L, ClaimBatch), String> {
+    // Namespace, queue, workers, lease and local slots come from a validated runner.
+    if !db.is_idle() {
+        return Err("Jobs prepared claim requires an idle PostgreSQL connection".into());
+    }
+    let slots = slots.min(MAX_CLAIM_BATCH);
+    let result = (|| {
+        db.simple(BEGIN)?;
+        let mut rows = db.query_utf8(PREPARE, &[namespace, queue, workers, &slots.to_string()])?;
+        let (transaction_id, manifest) = prepare_manifest(&mut rows)?;
+        // The PostgreSQL driver has already checked UTF-8 and result/value limits.
+        // Reuse stock length, ordinal and row-shape validation before activation.
+        let mut batch = decode_claim_batch(rows, slots, false)?;
+        let lease = begin_lease()?;
+        if !manifest.is_empty() {
+            let manifest_json = serde_json::to_string(&manifest).map_err(|err| err.to_string())?;
+            let confirmed = db.query_utf8(
+                ACTIVATE,
+                &[
+                    namespace,
+                    queue,
+                    workers,
+                    &lease_ms.to_string(),
+                    &transaction_id,
+                    &manifest_json,
+                    if observe { "true" } else { "false" },
+                ],
+            )?;
+            retain_confirmed(&mut batch, &manifest, confirmed, observe)?;
+            // Capacity, pause or lock ownership may have changed while delivering.
+            batch.contention_hint = batch.claims.is_empty() && batch.oversized.is_empty();
+        } else {
+            batch.contention_hint =
+                super::prepared_claim_contention(db, namespace, queue, workers)?;
+        }
+        if !db.in_transaction() {
+            return Err("mesh jobs prepared claim lost its transaction".into());
+        }
+        db.confirm_commit()?;
+        Ok((lease, batch))
+    })();
+    result.map_err(|error| rollback_error(error, db.simple("ROLLBACK")))
+}
+
+fn invalid() -> String {
+    "mesh jobs invalid prepared batch result from PostgreSQL".into()
+}
+
+fn prepare_manifest(rows: &mut [Vec<(String, String)>]) -> Result<(String, Vec<Entry>), String> {
+    let mut transaction_id = String::new();
+    let mut manifest = Vec::with_capacity(rows.len());
+    let mut seen = HashSet::with_capacity(rows.len());
+    let mut remaining_bytes = MAX_BATCH_WIRE_BYTES;
+    for row in rows {
+        // Count the DataRow frame, field lengths and UTF-8 values.
+        let wire_bytes = 7 + 4 * row.len() + row.iter().map(|(_, v)| v.len()).sum::<usize>();
+        remaining_bytes = remaining_bytes
+            .checked_sub(wire_bytes)
+            .ok_or_else(invalid)?;
+        let (_, xid) = row.pop().ok_or_else(invalid)?;
+        let (_, row_location) = row.pop().ok_or_else(invalid)?;
+        let (_, row_version) = row.pop().ok_or_else(invalid)?;
+        let [(.., status), (.., id), (.., token), _, _, (.., bytes), (.., ordinal)] =
+            row.as_mut_slice()
+        else {
+            return Err(invalid());
+        };
+        if id.len() != 36 || !seen.insert(id.clone()) {
+            return Err(invalid());
+        }
+        let ordinal = ordinal.parse::<usize>().map_err(|_| invalid())?;
+        if ordinal == 1 {
+            if xid.parse::<u64>().ok().filter(|id| *id > 0).is_none() {
+                return Err(invalid());
+            }
+            transaction_id = xid;
+        } else if !xid.is_empty() {
+            return Err(invalid());
+        }
+        match status.as_str() {
+            "prepared" if token.len() == 36 => *status = "claimed".into(),
+            "oversized" if token.is_empty() => {}
+            _ => return Err(invalid()),
+        }
+        manifest.push((
+            ordinal,
+            Entry {
+                id: id.clone(),
+                token: (!token.is_empty()).then(|| token.clone()),
+                context_bytes: bytes.parse().map_err(|_| invalid())?,
+                row_version,
+                row_location,
+            },
+        ));
+        // The stock batch decoder places the optional observation before the ordinal.
+        row.insert(6, (String::new(), String::new()));
+    }
+    manifest.sort_unstable_by_key(|(ordinal, _)| *ordinal);
+    Ok((
+        transaction_id,
+        manifest.into_iter().map(|(_, entry)| entry).collect(),
+    ))
+}
+
+fn retain_confirmed(
+    batch: &mut ClaimBatch,
+    manifest: &[Entry],
+    rows: Vec<Vec<(String, String)>>,
+    observe: bool,
+) -> Result<(), String> {
+    let mut rows = rows.into_iter();
+    let [(_, status), (_, total), (_, unused)] = rows
+        .next()
+        .ok_or_else(invalid)?
+        .try_into()
+        .map_err(|_| invalid())?;
+    if status != "count"
+        || !unused.is_empty()
+        || total.parse::<usize>().ok() != Some(rows.len())
+        || rows.len() > manifest.len()
+    {
+        return Err(invalid());
+    }
+    let mut claimed = HashMap::new();
+    let mut oversized = 0;
+    for (entry, row) in manifest.iter().zip(rows) {
+        let [(_, status), (_, id), (_, observed)] = row.try_into().map_err(|_| invalid())?;
+        if entry.id != id {
+            return Err(invalid());
+        }
+        match (entry.token.is_some(), status.as_str()) {
+            (true, "claimed") if observe || observed.is_empty() => {
+                let timestamp = observe
+                    .then(|| observed.parse().map_err(|_| invalid()))
+                    .transpose()?;
+                if claimed.insert(id, timestamp).is_some() {
+                    return Err(invalid());
+                }
+            }
+            (false, "oversized") if observed.is_empty() => oversized += 1,
+            _ => return Err(invalid()),
+        }
+    }
+    batch.claims.retain_mut(|job| {
+        let Some(observed_at_ms) = claimed.remove(&job.id) else {
+            return false;
+        };
+        job.observed_at_ms = observed_at_ms;
+        true
+    });
+    batch.oversized.truncate(oversized);
+    if !claimed.is_empty() {
+        return Err(invalid());
+    }
+    Ok(())
+}
