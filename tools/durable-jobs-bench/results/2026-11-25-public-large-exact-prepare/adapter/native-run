#!/usr/bin/env bash
# Invoked by the Linode matrix under its separate TIMING assignment.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd -P)"
stage="$(cd "$here/.." && pwd -P)"
source="$stage/source"
base=/var/lib/durable-jobs-bench/native
artifact="${PRODUCT_ARTIFACT:?}"
mode="${PRODUCT_COMPOSITION:?}"
[[ "$artifact" == "$stage/artifact" || "$artifact" == "$base/builds/trusted-jobs-product-623c46b92cc5" ]]
case "${PRODUCT_CLAIM_MODE:?}" in
    stock) ;;
    prepared) [[ "$artifact" == "$stage/artifact" ]] ;;
    *) exit 2 ;;
esac
case "$mode" in
    product-bulk|product-group|product-d2) ;;
    *) exit 2 ;;
esac
[[ "$#" == 3 && "$1" == mesh && "$3" == /* && ! -L "$3" ]]
[[ "$2" == large && "$mode" == product-bulk && "${PRODUCT_TOPOLOGY:?}" == stock ]]
[[ "${PRODUCT_SESSION_MODE:?}" == file ]]
[[ "${PRODUCT_SESSION_EXECUTABLE:?}" == /* && ! -L "$PRODUCT_SESSION_EXECUTABLE" ]]
[[ "${PRODUCT_SESSION_SHA256:?}" =~ ^[a-f0-9]{64}$ ]]
printf '%s  %s\n' "$PRODUCT_SESSION_SHA256" "$PRODUCT_SESSION_EXECUTABLE" | sha256sum -c >&2
exec 9<"$base/native.lock"
flock -n 9
args=(env -i "PATH=/usr/sbin:/usr/bin:/bin" LC_ALL=C.UTF-8
    "PG_BIN_DIR=$base/toolchain/pgsql-17.11/bin" "NATIVE_JOBS_STATE=$base"
    "PRODUCT_SOURCE=$source" "PRODUCT_COMPOSITION=$mode"
    "PRODUCT_TOPOLOGY=${PRODUCT_TOPOLOGY:?}" "PRODUCT_STORAGE=${PRODUCT_STORAGE:?}" \
    "PRODUCT_SESSION_MODE=$PRODUCT_SESSION_MODE" "PRODUCT_SESSION_EXECUTABLE=$PRODUCT_SESSION_EXECUTABLE" \
    "PRODUCT_SESSION_SHA256=$PRODUCT_SESSION_SHA256"
    "PRODUCT_FROZEN_HARNESS=$base/source-bulk-enqueue-3b09dc3d0e23/ordinary-v2"
    "PRODUCT_ELF_SHA256=${PRODUCT_ELF_SHA256:?}" "PRODUCT_MANIFEST_SHA256=${PRODUCT_MANIFEST_SHA256:?}"
    "PRODUCT_CLAIM_MODE=$PRODUCT_CLAIM_MODE"
    "PRODUCT_PREPARE_INSTALLER=$source/compiler/mesh-rt/src/jobs/prepare_claim_install.sql"
    "PRODUCT_PREPARE_MODULE=$stage/pg17_lock_exact.so"
    "NATIVE_JOBS_ARTIFACTS=$artifact" "DURABLE_JOBS_PHASE=${DURABLE_JOBS_PHASE:-diagnostic}")
cd "$here"
if [[ "$(id -u)" == 0 ]]; then
    [[ -d "$3" && -z "$(find "$3" -mindepth 1 -maxdepth 1 -print -quit)" ]]
    chown nobody:nogroup "$3"
    chmod 0700 "$3"
    exec runuser -u nobody -- "${args[@]}" python3 -B "$here/product_arm.py" "$@"
fi
exec "${args[@]}" python3 -B "$here/product_arm.py" "$@"
