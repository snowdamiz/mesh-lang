+// Serde writes the rest of an already opened string, including its closing quote.
+struct StringSuffix;
+
+impl serde_json::ser::Formatter for StringSuffix {
+    fn begin_string<W: ?Sized + std::io::Write>(&mut self, _: &mut W) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+fn needs_json_escape(byte: u8) -> bool {
+    (byte < 0x20) | (byte == b'"') | (byte == b'\\')
+}
+
+fn write_dominant_string(out: &mut Vec<u8>, text: &str) -> serde_json::Result<()> {
+    out.push(b'"');
+    let bytes = text.as_bytes();
+    for (index, block) in bytes.chunks(128).enumerate() {
+        let escape = block.iter().fold(0u8, |mask, &byte| {
+            mask | u8::from(needs_json_escape(byte))
+        });
+        if escape != 0 {
+            let offset = block.iter().position(|&byte| needs_json_escape(byte))
+                .expect("escape in block");
+            // Every escape byte is ASCII, so the suffix starts at a UTF-8 boundary.
+            let first = index * 128 + offset;
+            out.extend_from_slice(&bytes[..first]);
+            let mut serializer = serde_json::Serializer::with_formatter(out, StringSuffix);
+            return text[first..].serialize(&mut serializer);
+        }
+    }
+    out.extend_from_slice(bytes);
+    out.push(b'"');
+    Ok(())
+}
+
+fn dominant_arg(args: &Value, input_len: usize) -> Option<String> {
+    let minimum = input_len.div_ceil(2).max(64 * 1024);
+    args.as_object()?.iter().find_map(|(key, value)| {
+        let text = value.as_str()?;
+        (text.len() >= minimum).then(|| key.clone())
+    })
+}
+
+// Keep serde map order and stock encoding for every key and sibling value.
+fn encode_dominant_arg(spec: &Value, key: &str) -> Result<String, String> {
+    let args = spec["args"].as_object().expect("validated Jobs args object");
+    let text = args[key].as_str().expect("selected Jobs string argument");
+    let mut out = Vec::with_capacity(text.len() + 512);
+    out.push(b'{');
+    let fields = spec.as_object().expect("serialized JobSpec object");
+    for (index, (name, value)) in fields.iter().enumerate() {
+        if index != 0 {
+            out.push(b',');
+        }
+        serde_json::to_writer(&mut out, name).map_err(|e| e.to_string())?;
+        out.push(b':');
+        if name != "args" {
+            serde_json::to_writer(&mut out, value).map_err(|e| e.to_string())?;
+            continue;
+        }
+        out.push(b'{');
+        for (i, (arg, value)) in args.iter().enumerate() {
+            if i != 0 {
+                out.push(b',');
+            }
+            serde_json::to_writer(&mut out, arg).map_err(|e| e.to_string())?;
+            out.push(b':');
+            if arg == key {
+                write_dominant_string(&mut out, text).map_err(|e| e.to_string())?;
+            } else {
+                serde_json::to_writer(&mut out, value).map_err(|e| e.to_string())?;
+            }
+        }
+        out.push(b'}');
+    }
+    out.push(b'}');
+    String::from_utf8(out).map_err(|e| e.to_string())
+}
