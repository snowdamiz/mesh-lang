+// The stock compact JSON encoder emits these UTF-8 bytes verbatim between quotes.
+// Check in blocks so an escaped value can take the ordinary encoder promptly.
+fn plain_json_string(text: &str) -> bool {
+    text.as_bytes().chunks(128).all(|block| {
+        let escape = block.iter().fold(0u8, |mask, &byte| {
+            mask | u8::from((byte < 0x20) | (byte == b'"') | (byte == b'\\'))
+        });
+        escape == 0
+    })
+}
+
+fn dominant_plain_arg(args: &Value, input_len: usize) -> Option<String> {
+    // At most two values can reach half of the complete input. Small or mixed
+    // specs continue to use the stock preparation and representation.
+    let minimum = (input_len / 2).max(64 * 1024);
+    args.as_object()?.iter().find_map(|(key, value)| {
+        let text = value.as_str()?;
+        (text.len() >= minimum && plain_json_string(text)).then(|| key.clone())
+    })
+}
+
+// Emit keys in the same serde_json Map iteration order as Value::serialize.
+// Delegate all escaping, number formatting, and nested containers to serde_json
+// except for the single string whose bytes were checked before preparation.
+fn encode_plain_arg(spec: &Value, key: &str) -> Result<String, String> {
+    let args = spec["args"].as_object().expect("validated Jobs args object");
+    let text = args[key].as_str().expect("selected Jobs string argument");
+    let mut out = Vec::with_capacity(text.len() + 512);
+    out.push(b'{');
+    let fields = spec.as_object().expect("serialized JobSpec object");
+    for (index, (name, value)) in fields.iter().enumerate() {
+        if index != 0 {
+            out.push(b',');
+        }
+        serde_json::to_writer(&mut out, name).map_err(|e| e.to_string())?;
+        out.push(b':');
+        if name != "args" {
+            serde_json::to_writer(&mut out, value).map_err(|e| e.to_string())?;
+            continue;
+        }
+        out.push(b'{');
+        for (i, (arg, value)) in args.iter().enumerate() {
+            if i != 0 {
+                out.push(b',');
+            }
+            serde_json::to_writer(&mut out, arg).map_err(|e| e.to_string())?;
+            out.push(b':');
+            if arg == key {
+                out.push(b'"');
+                out.extend_from_slice(text.as_bytes());
+                out.push(b'"');
+            } else {
+                serde_json::to_writer(&mut out, value).map_err(|e| e.to_string())?;
+            }
+        }
+        out.push(b'}');
+    }
+    out.push(b'}');
+    String::from_utf8(out).map_err(|e| e.to_string())
+}
