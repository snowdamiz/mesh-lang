+def runner_cpu_clock():
+    # Linux x86_64 glibc uses signed int for pid_t and clockid_t.
+    resolve = ctypes.CDLL(None).clock_getcpuclockid
+    resolve.argtypes = (ctypes.c_int, ctypes.POINTER(ctypes.c_int))
+    resolve.restype = ctypes.c_int
+
+    def read(pid):
+        clock_id = ctypes.c_int()
+        error = resolve(pid, ctypes.byref(clock_id))
+        if error:
+            raise OSError(error, os.strerror(error), pid)
+        return time.clock_gettime_ns(clock_id.value)
+
+    return read
+
+
+def bind_runner_pids(capture, stack):
+    watches = {}
+    for pid, role in capture.items():
+        if role != "engine_runner_root":
+            continue
+        try:
+            fd = os.pidfd_open(pid)
+        except OSError:
+            # No identity witness. Keep this PID missing throughout the arm.
+            continue
+        stack.callback(os.close, fd)
+        watch = select.poll()
+        watch.register(fd, select.POLLIN)
+        watches[pid] = watch
+    return watches
+
+
+def runner_cpu_for_live_pid(pid, runner_cpu_ns, watches):
+    watch = watches.get(pid)
+    if watch is None or watch.poll(0):
+        raise ProcessLookupError(f"runner {pid} is unavailable")
+    absolute = runner_cpu_ns(pid)
+    if watch.poll(0):
+        raise ProcessLookupError(f"runner {pid} exited while reading its CPU clock")
+    return absolute
+
+
+def cpu_frame(capture, runner_cpu_ns, watches):
