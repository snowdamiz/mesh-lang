 #[cfg(test)]
 mod tests {
     use super::*;
+
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    #[test]
+    fn completed_stacks_are_cleared_and_cached_only_on_their_owner() {
+        IDLE_STACKS.with(|idle| idle.borrow_mut().clear());
+        let mut handles: Vec<_> = (0..=MAX_IDLE_STACKS)
+            .map(|_| CoroutineHandle::from_entry(|| {}))
+            .collect();
+        for handle in &mut handles {
+            assert!(!handle.resume());
+        }
+        let last_cached = &handles[MAX_IDLE_STACKS - 1];
+        let stack_limit = last_cached.stack_limit;
+        let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as usize;
+        let payload = (stack_limit + page) as *mut u8;
+        // Fill a writable page that remains owned by this finished coroutine.
+        unsafe { payload.write_bytes(0xA5, page) };
+        for handle in handles {
+            drop(handle);
+        }
+        IDLE_STACKS.with(|idle| assert_eq!(idle.borrow().len(), MAX_IDLE_STACKS));

+        std::thread::spawn(move || {
+            // The original owner still has the mapping, so another thread
+            // cannot receive it even if the kernel tends to reuse addresses.
+            assert_ne!(allocate_stack().limit().get(), stack_limit);
+        })
+        .join()
+        .unwrap();
+
+        let stack = allocate_stack();
+        assert_eq!(stack.limit().get(), stack_limit);
+        let payload = (stack.limit().get() + page) as *const u8;
+        assert!(unsafe { std::slice::from_raw_parts(payload, page) }
+            .iter()
+            .all(|&byte| byte == 0));
+    }
+
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    #[test]
+    fn reused_stack_still_reports_a_foreign_guard_fault() {
+        use std::os::unix::process::ExitStatusExt;
+
+        const CHILD: &str = "MESH_TEST_REUSED_STACK_GUARD";
+        if std::env::var_os(CHILD).is_some() {
+            crate::stack_overflow::install_for_current_thread();
+            let mut limit_source = CoroutineHandle::from_entry(|| {});
+            assert!(!limit_source.resume());
+            let limit = limit_source.stack_limit;
+            drop(limit_source);
+
+            extern "C-unwind" fn write_to_guard(guard: *const u8) {
+                unsafe { guard.cast_mut().write_volatile(0xA5) };
+            }
+            let mut foreign = CoroutineHandle::new(write_to_guard as *const u8, limit as *const u8);
+            assert_eq!(foreign.stack_limit, limit);
+            foreign.resume();
+            panic!("guard unexpectedly writable");
+        }
+
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "actor::stack::tests::reused_stack_still_reports_a_foreign_guard_fault",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .output()
+            .expect("run reused stack guard probe");
+        assert_eq!(output.status.signal(), Some(libc::SIGABRT), "{output:?}");
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        assert!(stderr.contains("R0002"), "{stderr}");
+    }
