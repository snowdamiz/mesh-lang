+#[cfg(any(target_os = "linux", target_os = "macos"))]
+const MAX_IDLE_STACKS: usize = 8;
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+thread_local! {
+    static IDLE_STACKS: RefCell<Vec<DefaultStack>> = const { RefCell::new(Vec::new()) };
+}
+
+fn allocate_stack() -> DefaultStack {
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    if let Ok(Some(stack)) = IDLE_STACKS.try_with(|idle| idle.borrow_mut().pop()) {
+        return stack;
+    }
+    DefaultStack::new(DEFAULT_STACK_SIZE).expect("failed to allocate coroutine stack")
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+fn recycle_stack(stack: DefaultStack) {
+    let _ = IDLE_STACKS.try_with(|idle| {
+        let mut idle = idle.borrow_mut();
+        if idle.len() < MAX_IDLE_STACKS && reset_stack(&stack) {
+            idle.push(stack);
+        }
+    });
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+fn reset_stack(stack: &DefaultStack) -> bool {
+    // DefaultStack rounds the usable bytes up to a page boundary. Mesh's
+    // 512 KiB size is an exact page multiple on both supported targets.
+    let payload = (stack.base().get() - DEFAULT_STACK_SIZE) as *mut libc::c_void;
+
+    // The completed coroutine has released its frames. Clear the anonymous
+    // writable pages before another actor can conservatively scan this stack.
+    // The separate PROT_NONE guard starts below the payload and stays mapped.
+    #[cfg(target_os = "linux")]
+    unsafe {
+        libc::madvise(payload, DEFAULT_STACK_SIZE, libc::MADV_DONTNEED) == 0
+    }
+    #[cfg(target_os = "macos")]
+    unsafe {
+        libc::mmap(
+            payload,
+            DEFAULT_STACK_SIZE,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_FIXED,
+            -1,
+            0,
+        ) == payload
+    }
+}
