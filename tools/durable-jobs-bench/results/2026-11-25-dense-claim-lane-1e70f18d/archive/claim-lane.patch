+// A diagnostic process owns one public runner. It retains a bounded set of
+// samples in memory and publishes once after attempts and the claim lane drain.
+static GRANT_DIAGNOSTICS: LazyLock<Option<GrantDiagnostics>> = LazyLock::new(|| {
+    std::env::var_os("MESH_JOBS_GRANT_DIAGNOSTICS").map(|path| GrantDiagnostics {
+        path: path.into(),
+        samples: Mutex::new((Vec::with_capacity(1024), 0)),
+    })
+});
+type GrantSample = (String, u128, u128, u128);
+
+struct GrantDiagnostics {
+    path: std::path::PathBuf,
+    samples: Mutex<(Vec<GrantSample>, usize)>,
+}
+
+pub(super) fn record_grant_entry(sample: GrantSample) {
+    if let Some(trace) = GRANT_DIAGNOSTICS.as_ref() {
+        let mut samples = trace.samples.lock();
+        if samples.0.len() < 4096 {
+            samples.0.push(sample);
+        } else {
+            samples.1 += 1;
+        }
+    }
+}
 
