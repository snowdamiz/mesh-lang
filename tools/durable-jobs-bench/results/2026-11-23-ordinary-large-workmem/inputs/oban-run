#!/usr/bin/env bash
set -euo pipefail
overlay="$(cd "$(dirname "$0")" && pwd -P)"
base=/var/lib/durable-jobs-bench/native
artifact="${NATIVE_JOBS_ARTIFACTS:?set NATIVE_JOBS_ARTIFACTS to the pinned Oban build}"
arm="${1:?usage: oban-run ABSOLUTE_STOCK_ARM PROFILE ABSOLUTE_EVIDENCE_DIR}"
profile="${2:?missing profile}"
out="${3:?missing evidence directory}"
[[ "$#" == 3 && "$arm" == "$base"/source-v5/* && "$profile" == large && "$out" == /* && ! -L "$out" ]]
[[ "$artifact" == "$base"/builds/* && -d "$artifact" ]]

# Preserve the stock native launcher lock, privilege drop and runtime environment.
exec 9>"$base/native.lock"
flock -n 9
tool="$base/toolchain"
env_args=(env -i
    "PATH=$tool/otp-29.1.1/bin:$tool/elixir-1.20.4/bin:/usr/bin:/bin"
    LC_ALL=C.UTF-8 "PG_BIN_DIR=$tool/pgsql-17.11/bin"
    ERL_CRASH_DUMP=/dev/null
    "DURABLE_JOBS_PHASE=${DURABLE_JOBS_PHASE:-diagnostic}"
    "NATIVE_JOBS_STATE=$base" "NATIVE_JOBS_ARTIFACTS=$artifact")
cd "$(dirname "$arm")"
command=(python3 -B "$overlay/overlay.py" oban "$arm" oban "$profile" "$out")
if [[ "$(id -u)" == 0 ]]; then
    [[ -d "$out" && -z "$(find "$out" -mindepth 1 -maxdepth 1 -print -quit)" ]]
    chown nobody:nogroup "$out"
    chmod 0700 "$out"
    exec runuser -u nobody -- "${env_args[@]}" "${command[@]}"
fi
exec "${env_args[@]}" "${command[@]}"
