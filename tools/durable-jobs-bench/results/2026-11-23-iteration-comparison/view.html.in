<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Durable Jobs on Linux</title>
<style>
* {box-sizing:border-box}
body {margin:0;background:#f6f7f4;color:#182b27;font:16px/1.5 "Inter",system-ui,sans-serif}
main {max-width:1040px;margin:auto;padding:clamp(16px,5vw,52px) clamp(16px,4vw,44px)}
h1 {font-size:clamp(30px,5vw,52px);line-height:1.06;letter-spacing:-.045em;margin:0 0 10px}
h2 {font-size:clamp(21px,3vw,30px);letter-spacing:-.025em;margin:0}
p {margin:.4em 0 .85em} .dim,small {color:#475e54}
.filters {display:grid;grid-template-columns:2fr 1fr 1.4fr;gap:12px;margin:24px 0}
label {display:grid;gap:4px;font-weight:600;font-size:13px}
select {width:100%;padding:9px 6px;color:inherit;background:white;border:1px solid #a6b5ad;border-radius:5px;font:inherit}
section {background:#fff;border:1px solid #cdd8d0;border-radius:10px;padding:clamp(14px,3vw,28px)}
.chart {margin:20px 0} .row {margin:12px 0}
.line {display:flex;justify-content:space-between;align-items:baseline;gap:12px} .line strong {font-variant-numeric:tabular-nums}
.track {height:8px;background:#f0f3ee;margin:4px 0;border-radius:2px;overflow:hidden}
.bar {height:100%;background:#326c5a}.bar.oban {background:#75569b}.bar.go {background:#187b92}.bar.rust {background:#ac5b3e}
details {margin-top:16px} summary {font-weight:650;cursor:pointer} .scroller {overflow:auto}
table {border-collapse:collapse;width:100%;margin:.7em 0;font-variant-numeric:tabular-nums;font-size:14px}
th,td {border-bottom:1px solid #e0e6df;padding:6px;text-align:right;white-space:nowrap} th:first-child,td:first-child {text-align:left}
a {color:#175e50} .figure-note {margin:12px 0 0;font-size:14px}
@media(max-width:650px) {.filters{grid-template-columns:1fr 1fr}.filters label:first-child{grid-column:1/-1}.line{font-size:15px}}
</style></head><body><main>
<h1>Durable Jobs on Linux</h1>
<p class="dim">Mesh, Elixir Oban, Go River and Rust Apalis on two pinned Linode CPUs and PostgreSQL 17.11.</p>
<div class="filters"><label>Comparison<select id="series"></select></label>
<label>Workload<select id="profile"></select></label><label>Measure<select id="metric"></select></label></div>
<section aria-live="polite"><h2 id="title"></h2><p id="scope"></p>
<div class="chart" id="chart"></div><p class="figure-note dim" id="note"></p>
<details id="paired"><summary>Head-to-head throughput</summary>
<label>Compare with<select id="opponent"></select></label>
<div class="scroller"><table id="pairs"></table></div></details>
<details><summary>Individual rotations and CPU steal</summary><div class="scroller"><table id="rotations"></table></div></details>
</section><p class="figure-note"><a id="download" href="scores.json" download="scores.json">Download scores and raw archive digests</a></p>
</main><script type="application/json" id="data">__REPLAYED_SCORES__</script>
<script>
"use strict";
const db=JSON.parse(document.getElementById("data").textContent);
const get=id=>document.getElementById(id);
get("download").href=URL.createObjectURL(new Blob([JSON.stringify(db,null,2)+"\n"],{type:"application/json"}));
const series=get("series"), profile=get("profile"), metric=get("metric");
const measures={
 submit_jobs_per_s:["Submit to settlement","jobs/s","Window starts with the producer submission and ends at the last durable settlement."],
 commit_jobs_per_s:["Enqueue commit to settlement","jobs/s","Window starts at the first durable enqueue commit and ends at the last durable settlement."],
 submit_to_settlement_p50_ms:["Submission to settlement p50","ms","Median per-job time from its submission to its durable terminal commit."],
 submit_to_settlement_p99_ms:["Submission to settlement p99","ms","99th percentile of per-job time from its submission to its durable terminal commit."],
 commit_to_settlement_p99_ms:["Enqueue commit to settlement p99","ms","99th percentile of per-job time from its enqueue commit to its durable terminal commit."],
 first_submit_to_commit_ms:["First submission to commit","ms","Producer latency through the first durable enqueue commit."],
 commit_to_pickup_p99_ms:["Pickup p99 from commit","ms","Each arm contributes its own 99th percentile."],
 runner_cpu_ms_per_job:["Runner CPU per job","ms/job","CPU charged to the runner process trees. PostgreSQL CPU is separate."],
 peak_runner_rss_bytes:["Peak runner RSS","MiB","Sampled sum of resident memory in the runner process trees. Shared pages can count once per process."],
 cpu_steal_percent:["CPU steal","%","Share of pinned CPU time charged to steal during the bracketing host samples."],
 cpu_iowait_percent:["CPU I/O wait","%","Share of pinned CPU time charged to I/O wait during the bracketing host samples."]
};
const workloads={noop:"Dense no-op",slow:"Slow · 64 slots",sparse:"Sparse arrivals",short:"Short · 16 slots",large:"Large · 512 KiB"};
const names={mesh:"Mesh",ordinary:"Mesh · trusted",stock:"Mesh · stock",current:"Mesh · current",historical:"Mesh · archived",
 "mesh-v1-2x32":"Mesh V1 · 2 × 32","mesh-v1-8x8":"Mesh V1 · 8 × 8",
 "river-2x32":"Go River · 2 × 32","river-8x8":"Go River · 8 × 8",
 "oban-2x32":"Elixir Oban · 2 × 32","oban-8x8":"Elixir Oban · 8 × 8",
 "apalis-2x32":"Rust Apalis · 2 × 32","apalis-8x8":"Rust Apalis · 8 × 8",
 lean:"Mesh · smaller worker",admission:"Mesh · set-based claims",combined:"Mesh · combined",
 "mesh-strict":"Mesh · fresh worker","mesh-trusted-persistent":"Mesh · reusable worker",
 "ordinary-4mb-a":"Mesh · 4 MiB control A","ordinary-4mb-b":"Mesh · 4 MiB control B",
 product:"Mesh · public trusted mode","frozen-v1":"Mesh · frozen V1",
 "bulk-default":"Mesh · default storage","bulk-external":"Mesh · EXTERNAL",
 "oban-default":"Elixir Oban · default storage","river-default":"Go River · default storage","apalis-default":"Rust Apalis · default storage",
 "bulk-d2":"Mesh · batch enqueue and hot checkout",
 "r2-d2":"Mesh · exit confirmed, hot checkout","r2-off":"Mesh · exit confirmed, checked checkout",
 "admission-v3":"Mesh · set-based admission","ordinary-stock":"Mesh · trusted, individual settlements",
 "ordinary-success-cohort":"Mesh · trusted, grouped settlements",bulk:"Mesh · batch enqueue",scalar:"Mesh · same binary, scalar enqueue",
 "protected-mesh":"Mesh · protected","mesh-stock-a":"Mesh · stock A","mesh-stock-b":"Mesh · stock B",
 "mesh-direct-file":"Mesh · direct producer","mesh-external":"Mesh · stock broker, EXTERNAL","mesh-direct-external":"Mesh · direct broker, EXTERNAL",
 go:"Go River",river:"Go River",oban:"Elixir Oban",rust:"Rust Apalis",apalis:"Rust Apalis",
 "river-external":"Go River · EXTERNAL","oban-external":"Elixir Oban · EXTERNAL","apalis-external":"Rust Apalis · EXTERNAL"};
const option=(v,t)=>new Option(t,v);
function element(tag,text,cls) {
 const e=document.createElement(tag); if(text!==undefined)e.textContent=text; if(cls)e.className=cls; return e;
}
function median(xs) {const x=xs.slice().sort((a,b)=>a-b),i=Math.floor(x.length/2);return x.length%2?x[i]:(x[i-1]+x[i])/2;}
const number=new Intl.NumberFormat("en-US",{maximumFractionDigits:2});
function draw() {
 const s=db[series.value], blocks=s.blocks.filter(b=>b.profile===profile.value);
 const key=metric.value, unit=measures[key][1];
 const value=(b,l)=>b.scores[l][key]/(key==="peak_runner_rss_bytes"?1048576:1);
 get("title").textContent=s.title;get("scope").textContent=s.description;
 const lanes=Object.keys(blocks[0].scores);
 const rows=lanes.map(l=>{const vals=blocks.map(b=>value(b,l));return {l,vals,m:median(vals)};});
 const high=Math.max(...rows.map(r=>r.m));
 const higherIsBetter=key.endsWith("jobs_per_s");
 rows.sort((a,b)=>higherIsBetter?b.m-a.m:a.m-b.m);
 const chart=get("chart");chart.replaceChildren();
 for(const r of rows) {
   const row=element("div",undefined,"row"), line=element("div",undefined,"line"), track=element("div",undefined,"track");
   line.append(element("span",names[r.l]??r.l),element("strong",number.format(r.m)+" "+unit));
   const bar=element("div",undefined,"bar "+blocks[0].scores[r.l].engine);
   bar.style.width=(high?100*r.m/high:0)+"%";track.append(bar);row.append(line,track);
   if(blocks.length>1)row.append(element("small","Range "+number.format(Math.min(...r.vals))+"–"+number.format(Math.max(...r.vals))));
   chart.append(row);
 }
 get("note").textContent=blocks.length+" of 5 matched rotations. "+(blocks.length===1?"Single observation. ":"Bars show the median. ")+measures[key][2];
 get("paired").hidden=!higherIsBetter;
 if(higherIsBetter) {
   const opponent=get("opponent"), previous=opponent.value;
   opponent.replaceChildren(...lanes.map(l=>option(l,names[l]??l)));
   opponent.value=lanes.includes(previous)?previous:lanes.find(l=>l.startsWith("oban"))??lanes[0];
   const table=get("pairs"), header=element("tr");
   for(const label of ["Engine","Rotations faster","Median paired change"])header.append(element("th",label));
   table.replaceChildren(header);
   for(const {l} of rows) {
     if(l===opponent.value)continue;
     const changes=blocks.map(b=>100*(value(b,l)/value(b,opponent.value)-1));
     const change=median(changes),line=element("tr");
     line.append(element("td",names[l]??l),element("td",changes.filter(x=>x>0).length+" / "+changes.length),
       element("td",(change>0?"+":"")+number.format(change)+"%"));
     table.append(line);
   }
 }
 const t=get("rotations");t.replaceChildren();
 const head=element("tr");for(const item of ["Group · execution order",measures[key][0]+" ("+unit+")","CPU steal (%)"])head.append(element("th",item));t.append(head);
 for(const b of blocks)for(const l of b.order) {
   const tr=element("tr");for(const x of [b.group+" · "+(names[l]??l),number.format(value(b,l)),number.format(b.scores[l].cpu_steal_percent)])tr.append(element("td",x));t.append(tr);
 }
}
function chooseSeries() {
 const prior=profile.value, b=db[series.value].blocks;profile.replaceChildren();
 for (const [id,label] of Object.entries(workloads)) if(b.some(row=>row.profile===id))profile.add(option(id,label));
 if([...profile.options].some(o=>o.value===prior))profile.value=prior;
 draw();
}
for(const [key,s] of Object.entries(db))if(s.blocks.length)series.add(option(key,s.title));
for(const [key,m] of Object.entries(measures))metric.add(option(key,m[0]));
const selected=location.hash.slice(1);
if(db[selected]?.blocks?.length)series.value=selected;
else if(db["exit-confirmed-hot-short"]?.blocks.length===5)series.value="exit-confirmed-hot-short";
else if(db["slow-storage"]?.blocks.length===5)series.value="slow-storage";
else if(db["bulk-hot-short-peers"]?.blocks.length===5)series.value="bulk-hot-short-peers";
else if(db["dense-equal-topology"]?.blocks.length===5)series.value="dense-equal-topology";
else if(db["bulk-short"]?.blocks.length===5)series.value="bulk-short";
else if(db["bulk-slow"]?.blocks.length===5)series.value="bulk-slow";
else if(db["ordinary-large"]?.blocks.length===5)series.value="ordinary-large";
else if(db.symmetric?.blocks.length)series.value="symmetric";
else series.value="baseline";
series.onchange=chooseSeries;profile.onchange=draw;metric.onchange=draw;get("opponent").onchange=draw;chooseSeries();
</script></body></html>
