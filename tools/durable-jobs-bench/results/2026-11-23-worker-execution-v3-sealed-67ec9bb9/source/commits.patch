+#!/bin/bash
+# Run as the same unprivileged account used by the native matrix.
+set -euo pipefail
+src="${1:?source checkout}"
+out="${2:?proof directory}"
+export PATH="${PG_BIN_DIR:?pinned PostgreSQL bin}:/usr/bin:/bin"
+export LC_ALL=C.UTF-8
+umask 077
+test "$(id -u)" != 0
+db="$(mktemp -d "$out/private.XXXXXX")"
+PORT=55431
+cleanup() {
+    pg_ctl -D "$db/data" -w -t 10 -m fast stop >/dev/null 2>&1 || :
+    rm -rf -- "$db"
+}
+trap cleanup EXIT
+mkdir -p "$out/results" "$db/pgsocket"
+openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=mesh-worker-execution-proof \
