#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd -P)"
base=/var/lib/durable-jobs-bench/native
artifact="${PRODUCT_ARTIFACT:?}"
[[ "$artifact" == "$base/builds/trusted-jobs-product-623c46b92cc5" ]]
[[ "$here" == "$base"/source-dense-producer-1024-*/packet-timing-splice ]]
[[ "$#" == 3 && "$1" == mesh && "$2" == noop && "$3" == /* && ! -L "$3" ]]
exec 9<"$base/native.lock"
flock -n 9
args=(env -i "PATH=/usr/sbin:/usr/bin:/bin" LC_ALL=C.UTF-8
    "PG_BIN_DIR=$base/toolchain/pgsql-17.11/bin" "NATIVE_JOBS_STATE=$base"
    "PRODUCT_SOURCE=$here/../source" "PRODUCT_FROZEN_HARNESS=$base/source-bulk-enqueue-3b09dc3d0e23/ordinary-v2"
    "PRODUCT_ELF_SHA256=${PRODUCT_ELF_SHA256:?}" "PRODUCT_MANIFEST_SHA256=${PRODUCT_MANIFEST_SHA256:?}"
    "NATIVE_JOBS_ARTIFACTS=$artifact" "DURABLE_JOBS_PHASE=${DURABLE_JOBS_PHASE:?}"
    "DENSE_WIDTH=${DENSE_WIDTH:?}" "DENSE_BROKER=$here/../broker/mesh"
    "DENSE_BROKER_SHA256=${DENSE_BROKER_SHA256:?}")
[[ "$(id -u)" == 0 && -d "$3" && -z "$(find "$3" -mindepth 1 -maxdepth 1 -print -quit)" ]]
chown nobody:nogroup "$3"
chmod 0700 "$3"
exec runuser -u nobody -- "${args[@]}" python3 -B "$here/adapter.py" "$@"
