+-- The caller presents only fully reaped successful handler outcomes. Omitted
+-- ordinals must go through the released scalar path, including operator cancel.
+CREATE OR REPLACE FUNCTION mesh_jobs.complete_admitted_v3(
+    ns text, ids uuid[], tokens uuid[]
+) RETURNS TABLE(ordinal bigint)
+LANGUAGE sql VOLATILE SET search_path = pg_catalog, pg_temp AS $$
+    WITH held AS MATERIALIZED (
+        SELECT j.id, j.lease_token, j.lease_expires_at_ms, p.ordinal
