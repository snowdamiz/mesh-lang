+// A lock timeout on the queued admission attempt is a definite rejection
+// only when the PostgreSQL error and idle ReadyForQuery are both received.
+pub(super) fn pg_jobs_try_admit(
+    conn: &mut PgConn,
+    sql: &str,
+    params: &[&str],
+) -> Result<Option<Vec<Vec<(String, String)>>>, String> {
+    let result = text_query(conn, sql, params);
+    if conn.txn_status != b'I' || conn.is_broken() {
+        return Err(result.err().map_or_else(
+            || "Jobs admitted claim did not confirm an idle commit".into(),
+            Failure::message,
+        ));
+    }
+    match result {
+        Ok(rows) => Ok(Some(rows)),
+        Err(Failure::Server(error)) if error.sqlstate == "55P03" => Ok(None),
+        Err(error) => Err(error.message()),
+    }
+}
