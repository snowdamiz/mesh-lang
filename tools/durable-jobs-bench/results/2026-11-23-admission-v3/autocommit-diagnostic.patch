+// The supervisor enters Acknowledging only after the consuming wait (and,
+// where configured, the effect relay). Snapshot only first-submission
+// successes; retries and every other outcome keep the scalar semantics.
+fn complete_reaped(
+    runner: &Runner,
+    io: &mut LifecycleIo,
+    attempts: &mut Vec<Attempt>,
+    freed: &mut HashSet<String>,
+) {
+    let ready: Vec<_> = {
+        let state = runner.state.lock();
+        attempts
+            .iter()
+            .enumerate()
+            .filter_map(|(index, attempt)| {
+                let job = &state.jobs[&attempt.token];
+                let Execution::Acknowledging {
+                    reply,
+                    retry_at: None,
+                    handler_duration_ms,
+                } = &job.execution
+                else {
+                    return None;
+                };
+                (attempt.submissions == 0
+                    && attempt.lease.is_some()
+                    && matches!(reply.outcome().0, Outcome::Complete))
+                .then(|| (index, *handler_duration_ms, job.identity.clone()))
+            })
+            .collect()
+    };
+    if ready.len() < 2 {
+        return;
+    }
+    let mut finished = HashSet::new();
+    for group in ready
+        .chunks(MAX_COMPLETE_COHORT)
+        .filter(|group| group.len() > 1)
+    {
+        let keys: Vec<_> = group
+            .iter()
+            .map(|(index, _, _)| {
+                let attempt = &attempts[*index];
+                (attempt.id.as_str(), attempt.token.as_str())
+            })
+            .collect();
+        // A connection checkout failure did not submit any rows.
+        let result = io.with(|db| Ok(complete_admitted(db, &runner.config.namespace, &keys)));
+        match result {
+            Ok(Ok(committed)) => {
+                for ((index, duration, identity), committed) in group.iter().zip(committed) {
+                    if !committed {
+                        continue; // Locked, expired, stale and cancelled rows use finish().
+                    }
+                    let attempt = &mut attempts[*index];
+                    attempt.submissions = 1;
+                    let ack = Acknowledgement {
+                        submission: 1,
+                        handler_duration_ms: *duration,
+                        failure_kind: None,
+                    };
+                    attempt.ack_result(runner, ack, identity.as_ref(), Ok(Settlement::Completed));
+                    finished.insert(*index);
+                }
+            }
+            Ok(Err(JobsAckError::Unconfirmed(error))) => {
+                // Do not reinterpret an absent response as successful. Each
+                // attempt retries its original token after its normal delay.
+                for (index, duration, identity) in group {
+                    let attempt = &mut attempts[*index];
+                    attempt.submissions = 1;
+                    let ack = Acknowledgement {
+                        submission: 1,
+                        handler_duration_ms: *duration,
+                        failure_kind: None,
+                    };
+                    attempt.ack_result(
+                        runner,
+                        ack,
+                        identity.as_ref(),
+                        Err(JobsAckError::Unconfirmed(error.clone())),
+                    );
+                }
+            }
+            // A confirmed SQL rejection can be handled independently by the
+            // ordinary path. There was no committed prefix of this group.
+            _ => {}
+        }
+    }
+    if finished.is_empty() {
+        return;
+    }
+    let mut index = 0;
+    attempts.retain(|attempt| {
+        let remove = finished.contains(&index);
+        index += 1;
+        if remove {
+            runner.state.lock().jobs.remove(&attempt.token);
+            if runner.wakeups.is_some() {
+                freed.insert(attempt.queue.clone());
+            }
+        }
+        !remove
+    });
+}
