+// A lock timeout is an expected contention result only if PostgreSQL
+// reported it and the explicit admission transaction is known to be aborted.
+pub(super) fn pg_jobs_try_admit(
+    conn: &mut PgConn,
+    sql: &str,
+    params: &[&str],
+) -> Result<Option<Vec<Vec<(String, String)>>>, String> {
+    match text_query_with_count(conn, sql, params) {
+        Ok((count, rows)) if conn.txn_status == b'T' && count == Some(rows.len() as i64) => {
+            Ok(Some(rows))
+        }
+        Ok(_) => Err("Jobs admitted claim did not confirm all rows in an open transaction".into()),
+        Err(Failure::Server(error)) if error.sqlstate == "55P03" && conn.txn_status == b'E' => {
+            Ok(None)
+        }
+        Err(error) => Err(error.message()),
+    }
+}
