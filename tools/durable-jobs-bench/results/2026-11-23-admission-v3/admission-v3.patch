+pub(super) enum AdmittedBatch {
+    Claimed(ClaimBatch),
+    Empty(Option<u64>),
+    Fallback,
+}
+
+// Keep the full payload inside a revocable transaction until decoding has
+// succeeded. Only a subsequent acknowledged COMMIT authorizes a launch.
+pub(super) fn claim_admitted(
+    db: &mut PgJobDb<'_>,
+    namespace: &str,
+    queue: &str,
+    workers: &str,
+    lease_ms: u64,
+    slots: usize,
+    observe: bool,
+) -> Result<AdmittedBatch, String> {
+    standalone(db)?;
+    db.simple("BEGIN ISOLATION LEVEL READ COMMITTED")?;
+    let result = (|| {
+        let Some(rows) = db.try_admit(
+            "SELECT status, id, token, context, timeout_ms, context_bytes,
+                    CASE WHEN $6::boolean AND status = 'claimed'
+                        THEN mesh_jobs.now_ms()::text END, ordinality::text
+             FROM mesh_jobs.claim_admitted_v3($1, $2, $3::jsonb, $4::bigint, $5::integer, NULL)
+             WITH ORDINALITY",
+            &[
+                namespace,
+                queue,
+                workers,
+                &lease_ms.to_string(),
+                &slots.to_string(),
+                &observe.to_string(),
+            ],
+        )?
+        else {
+            db.simple("ROLLBACK")?;
+            return Ok(AdmittedBatch::Claimed(ClaimBatch {
+                contention_hint: true,
+                ..ClaimBatch::default()
+            }));
+        };
+        let batch = decode_admitted_batch(rows, slots, observe)?;
+        db.confirm_commit()?;
+        Ok(batch)
+    })();
+    result.map_err(|error| rollback_error(error, db.simple("ROLLBACK")))
+}
+
+fn decode_admitted_batch(
+    rows: Vec<Vec<(String, String)>>,
+    slots: usize,
+    observe: bool,
+) -> Result<AdmittedBatch, String> {
+    let invalid = || "Jobs admitted claim returned invalid fields".to_string();
+    match rows.as_slice() {
+        [] => return Ok(AdmittedBatch::Empty(None)),
+        [row] if row.len() == 8 && matches!(row[0].1.as_str(), "empty" | "fallback") => {
+            let empty = row[0].1 == "empty";
+            if row[7].1 != "1"
+                || row[1..7]
+                    .iter()
+                    .enumerate()
+                    .any(|(i, (_, value))| i != 3 && !value.is_empty())
+                || (!empty && !row[4].1.is_empty())
+            {
+                return Err(invalid());
+            }
+            return if empty {
+                row[4]
+                    .1
+                    .parse()
+                    .map(|cutoff| AdmittedBatch::Empty(Some(cutoff)))
+                    .map_err(|_| invalid())
+            } else {
+                Ok(AdmittedBatch::Fallback)
+            };
+        }
+        _ => {}
+    }
+    let batch = decode_claim_batch(rows, slots, observe)?;
+    if batch.contention_hint || !batch.oversized.is_empty() || batch.claims.is_empty() {
+        return Err(invalid());
+    }
+    #[derive(Deserialize)]
+    struct Context<'a> {
+        id: &'a str,
+    }
+    let uuid = |value: &str| {
+        value.len() == 36
+            && value.bytes().enumerate().all(|(index, byte)| match index {
+                8 | 13 | 18 | 23 => byte == b'-',
+                _ => byte.is_ascii_hexdigit(),
+            })
+    };
+    for claim in &batch.claims {
+        if !uuid(&claim.id)
+            || !uuid(&claim.token)
+            || claim.timeout_ms == 0
+            || (observe && claim.observed_at_ms.is_none())
+            || !serde_json::from_str::<Context>(&claim.context)
+                .is_ok_and(|context| context.id == claim.id)
+        {
+            return Err(invalid());
+        }
+    }
+    Ok(AdmittedBatch::Claimed(batch))
+}
+
+pub(super) const MAX_COMPLETE_COHORT: usize = 8;
+
+pub(super) fn complete_admitted(
+    db: &mut impl Database,
+    namespace: &str,
+    jobs: &[(&str, &str)],
+) -> Result<[bool; MAX_COMPLETE_COHORT], JobsAckError> {
+    standalone(db).map_err(JobsAckError::Rejected)?;
+    debug_assert!(!jobs.is_empty() && jobs.len() <= MAX_COMPLETE_COHORT);
+    // IDs and tokens already came from the typed UUID claim result.
+    let uuid_array = |values: Vec<&str>| format!("{{{}}}", values.join(","));
+    let ids = uuid_array(jobs.iter().map(|(id, _)| *id).collect());
+    let tokens = uuid_array(jobs.iter().map(|(_, token)| *token).collect());
+    let rows = db.acknowledge(
+        "SELECT ordinal::text FROM mesh_jobs.complete_admitted_v3($1,$2::uuid[],$3::uuid[])",
+        &[namespace, &ids, &tokens],
+    )?;
+    let mut completed = [false; MAX_COMPLETE_COHORT];
+    let invalid =
+        || JobsAckError::Unconfirmed("Jobs admitted completion returned an invalid ordinal".into());
+    for row in rows {
+        let [(_, ordinal)] = row.as_slice() else {
+            return Err(invalid());
+        };
+        let ordinal = ordinal.parse::<usize>().map_err(|_| invalid())?;
+        let index = ordinal
+            .checked_sub(1)
+            .filter(|&index| index < jobs.len())
+            .ok_or_else(invalid)?;
+        if std::mem::replace(&mut completed[index], true) {
+            return Err(invalid());
+        }
+    }
+    Ok(completed)
+}
