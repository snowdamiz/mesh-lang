+#[test]
+#[ignore = "requires a one-connection admission wire fault relay"]
+fn admitted_wire_grant_never_escapes_uncertain_or_malformed_result() {
+    use crate::db::pool::{mesh_pool_close, mesh_pool_open, unbox_u64_payload};
+    use crate::io::MeshResult;
+    use crate::string::mesh_str;
+
+    crate::gc::mesh_rt_init();
+    let Ok(url) = std::env::var("MESH_JOBS_ADMISSION_TEST_URL") else {
+        return;
+    };
+    let namespace =
+        std::env::var("MESH_JOBS_ADMISSION_TEST_NAMESPACE").expect("fresh fault namespace");
+    let pool = unsafe { &*mesh_pool_open(mesh_str(&url), 0, 1, 500).cast::<MeshResult>() };
+    assert_eq!(pool.tag, 0);
+    let pool = unsafe { unbox_u64_payload(pool.value) };
+    let mut session = unsafe { JobSession::from_pool(pool) }.unwrap();
+    let result = session.with(|db| {
+        claim_admitted(
+            db,
+            &namespace,
+            "default",
+            r#"[{"worker":"parity","version":1}]"#,
+            750,
+            2,
+            false,
+        )
+    });
+    assert!(
+        result.is_err(),
+        "the client must never receive a launchable grant"
+    );
+    drop(session);
+    mesh_pool_close(pool);
+}
