+pub(super) fn pg_jobs_confirm_commit(conn: &mut PgConn) -> Result<(), String> {
+    let mut committed = false;
+    request(conn, "COMMIT", b"Q\0\0\0\x0bCOMMIT\0", |tag, body| {
+        if tag == b'C' && body == b"COMMIT\0" && !committed {
+            committed = true;
+            Ok(())
+        } else {
+            Err("Jobs expected one COMMIT command receipt".into())
+        }
+    })
+    .map_err(Failure::message)?;
+    if committed && conn.txn_status == b'I' {
+        Ok(())
+    } else {
+        Err("Jobs did not confirm an idle COMMIT".into())
+    }
+}
