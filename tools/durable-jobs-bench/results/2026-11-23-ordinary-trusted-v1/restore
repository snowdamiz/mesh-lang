#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd -P)"
root="$(git -C "$here" rev-parse --show-toplevel)"
id="${1:-ordinary-trusted-v1-replay}"
[[ "$id" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]
destination="$root/target/$id"
(
    cd "$here"
    shasum -a 256 -c SHA256SUMS
)
mkdir "$destination"
cp -p "$here/ordinary-trusted-v1.tar.gz" "$destination/"
cp -Rp "$here/replay" "$destination/"
if [[ -d "$here/evidence" ]]; then
    cp -Rp "$here/evidence" "$destination/"
else
    mkdir "$destination/evidence"
fi
printf '%s\n' "$destination"
